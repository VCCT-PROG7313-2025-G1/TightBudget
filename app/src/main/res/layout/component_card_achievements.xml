<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAchievements"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Saver -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/saverBadgeIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text=""
                android:textSize="24sp"
                android:gravity="center"
                android:padding="8dp"
                android:contentDescription="Saver Badge Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saver"
                android:textColor="@color/text_medium"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Consistent -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/consistentBadgeIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text=""
                android:textSize="24sp"
                android:gravity="center"
                android:padding="8dp"
                android:contentDescription="Consistent Badge Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consistent"
                android:textColor="@color/text_medium"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Transport -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/transportBadgeIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text=""
                android:textSize="24sp"
                android:gravity="center"
                android:padding="8dp"
                android:contentDescription="Transport Badge Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport"
                android:textColor="@color/text_medium"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Locked -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/lockedBadgeIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text=""
                android:alpha="0.5"
                android:textSize="24sp"
                android:gravity="center"
                android:padding="8dp"
                android:contentDescription="Locked Badge Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Locked"
                android:textColor="@color/text_light"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- All Badges button -->
    <TextView
        android:id="@+id/allBadgesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All Badges"
        android:textColor="@color/primary_purple_light"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="end"
        android:layout_margin="12dp" />
</androidx.cardview.widget.CardView>